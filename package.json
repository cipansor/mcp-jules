{
  "name": "mcp-jules",
  "version": "0.2.0",
  "description": "MCP server for the Google Jules AI coding agent API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "mcp-jules": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "check": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "start": "node dist/index.js",
    "test": "npm run build && node --test",
    "dev": "tsc --watch"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "jules",
    "google",
    "ai",
    "coding",
    "agent",
    "model-context-protocol"
  ],
  "author": "Yayasan Pesantren Cipansor",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cipansor/mcp-jules.git"
  },
  "homepage": "https://github.com/cipansor/mcp-jules#readme",
  "bugs": {
    "url": "https://github.com/cipansor/mcp-jules/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "axios": "^1.20.0",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.1",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1"
  }
}
